# http-parser: bytes in any framing, callbacks with slices of your own buffer.
# Render: d2 --layout elk --sketch --theme 302 docs/http-parser.d2 docs/http-parser.svg
direction: right

wire: bytes {
  style.multiple: true
  label: "bytes, in any chunks\nhttp_parser_execute()"
}

parser: http_parser {
  label: "state machine\nkeeps state across calls"
}

callbacks: your callbacks {
  label: "on_url · on_header_field · on_header_value\non_headers_complete · on_body · on_message_complete"
}

fields: parser fields {
  label: "method · status_code · http_major/minor\ncontent_length · upgrade · http_errno"
}

wire -> parser
parser -> callbacks: "slices of your buffer"
parser -> fields
